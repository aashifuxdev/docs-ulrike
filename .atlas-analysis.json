  "publicApiSurface": [
    "POST /articles — create an article",
    "GET /articles/{articleId} — retrieve an article",
    "PUT /articles/{articleId} — update an article",
    "DELETE /articles/{articleId} — delete an article",
    "GET /categories — list categories",
    "POST /categories — create a category",
    "GET /search?query= — search articles",
    "POST /ai/generate — generate content with Eddy AI",
    "GET /analytics/knowledge-pulse — retrieve analytics",
    "GET /users — list team members",
    "POST /api-tokens — create an API token"
